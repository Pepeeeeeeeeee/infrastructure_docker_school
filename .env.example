EMAIL=your-email@example.com

PROJECT_NAME=infra-chat

GCLOUD_VM_NAME=infra3-chat-vm

GCLOUD_ZONE=europe-west1-b

GCLOUD_MACHINE_TYPE=e2-small

GCLOUD_IMAGE_FAMILY=debian-12

GCLOUD_IMAGE_PROJECT=debian-cloud

DUCKDNS_DOMAINS=your-domain,your-domain-kuma

DUCKDNS_TOKEN=your-duckdns-token

CHAT_DOMAIN=your-domain.duckdns.org

KUMA_DOMAIN=your-domain-kuma.duckdns.org

REMOTE_DIR=infra-chat

DEPLOY_MODE=scp

GITLAB_PROJECT_TOKEN=your-gitlab-token

GIT_REPO=https://oauth2:${GITLAB_PROJECT_TOKEN}@gitlab.com/your-namespace/your-repo.git

GIT_BRANCH=main

GCLOUD_PROJECT_ID=your-gcloud-project-id

DB_HOST=postgres
DB_PORT=5432
DB_NAME=chatdb
DB_USER=chatuser
DB_PASSWORD=your-db-password
